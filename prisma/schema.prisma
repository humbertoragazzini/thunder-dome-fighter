// ==================================================
// PRISMA CONFIGURATION & DATASOURCE
// ==================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================================================
// 1. User: Security & Authentication Account
// Decoupled from character/player attributes (ADR-004)
// ==================================================
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  player       Player?
  sessions     Session[]

  @@map("users")
}

// ==================================================
// 2. Player: Public In-Game Persona
// Represents the competitive identity and display name
// ==================================================
model Player {
  id         String       @id @default(uuid())
  userId     String       @unique @map("user_id")
  playerName String       @unique @map("player_name")
  avatarUrl  String?      @map("avatar_url")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // Relations
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions            Session[]
  stats               PlayerStats?
  matchParticipations MatchParticipant[]
  itemStats           PlayerItemStats[]

  @@map("players")
}

// ==================================================
// 3. Session: Active JWT Sessions
// Issued on login, validated in Colyseus onAuth handshake
// ==================================================
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  playerId  String   @map("player_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==================================================
// 4. PlayerStats: Permanent Lifetime Competitive Records
// Updated strictly by authoritative match finalization (ADR-012)
// ==================================================
model PlayerStats {
  playerId       String   @id @map("player_id")
  totalMatches   Int      @default(0) @map("total_matches")
  wins           Int      @default(0)
  losses         Int      @default(0)
  kills          Int      @default(0)
  deaths         Int      @default(0)
  assists        Int      @default(0)
  damageDealt    Int      @default(0) @map("damage_dealt")
  damageReceived Int      @default(0) @map("damage_received")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

// ==================================================
// 5. Match: Authoritative Game Instance Record
// Created on match finalization (ADR-005, ADR-012)
// ==================================================
model Match {
  id               String             @id @default(uuid())
  roomCode         String?            @map("room_code")
  gameModeId       String             @map("game_mode_id")
  levelId          String             @map("level_id")
  status           String             @default("COMPLETED") // "COMPLETED" | "CANCELLED"
  winningTeamIndex Int?               @map("winning_team_index")
  winningPlayerId  String?            @map("winning_player_id")
  durationSeconds  Float              @default(0) @map("duration_seconds")
  startedAt        DateTime           @default(now()) @map("started_at")
  endedAt          DateTime?          @map("ended_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  // Relations
  participants     MatchParticipant[]
  teams            MatchTeam[]
  itemStats        PlayerItemStats[]

  @@map("matches")
}

// ==================================================
// 6. MatchParticipant: Individual Player Match Results
// ==================================================
model MatchParticipant {
  id             String   @id @default(uuid())
  matchId        String   @map("match_id")
  playerId       String   @map("player_id")
  teamIndex      Int      @default(0) @map("team_index")
  finalScore     Int      @default(0) @map("final_score")
  kills          Int      @default(0)
  deaths         Int      @default(0)
  assists        Int      @default(0)
  damageDealt    Int      @default(0) @map("damage_dealt")
  damageReceived Int      @default(0) @map("damage_received")
  isWinner       Boolean  @default(false) @map("is_winner")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("match_participants")
}

// ==================================================
// 7. MatchTeam: Team Performance Aggregates
// ==================================================
model MatchTeam {
  id         String   @id @default(uuid())
  matchId    String   @map("match_id")
  teamIndex  Int      @map("team_index")
  teamName   String   @default("") @map("team_name")
  score      Int      @default(0)
  isWinner   Boolean  @default(false) @map("is_winner")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamIndex])
  @@map("match_teams")
}

// ==================================================
// 8. PlayerItemStats: Weapon and Item Performance
// ==================================================
model PlayerItemStats {
  id          String   @id @default(uuid())
  matchId     String   @map("match_id")
  playerId    String   @map("player_id")
  itemId      String   @map("item_id")
  hits        Int      @default(0)
  kills       Int      @default(0)
  damageDealt Int      @default(0) @map("damage_dealt")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId, itemId])
  @@index([playerId, itemId])
  @@map("player_item_stats")
}

// ==================================================
// 9. Tournament: Authoritative Tournament Record
// Coordinates brackets, rounds, matches, and champions (Phase 20)
// ==================================================
model Tournament {
  id              String                  @id @default(uuid())
  name            String
  format          String                  @default("KNOCKOUT") // "KNOCKOUT" | "ROUND_ROBIN"
  status          String                  @default("PENDING")  // "PENDING" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  participantType String                  @default("INDIVIDUAL") @map("participant_type") // "INDIVIDUAL" | "TEAM"
  gameModeId      String                  @map("game_mode_id")
  championId      String?                 @map("champion_id")
  championName    String?                 @map("champion_name")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  // Relations
  participants    TournamentParticipant[]
  stages          TournamentStage[]

  @@map("tournaments")
}

// ==================================================
// 10. TournamentParticipant: Seeding & Placements
// ==================================================
model TournamentParticipant {
  id              String      @id @default(uuid())
  tournamentId    String      @map("tournament_id")
  participantType String      @default("INDIVIDUAL") @map("participant_type")
  seed            Int
  name            String
  avatarUrl       String?     @map("avatar_url")
  playerId        String?     @map("player_id")
  memberIds       String[]    @default([]) @map("member_ids")
  isEliminated    Boolean     @default(false) @map("is_eliminated")
  finalPlacement  Int?        @map("final_placement")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([playerId])
  @@map("tournament_participants")
}

// ==================================================
// 11. TournamentStage: Tournament Phase Container
// ==================================================
model TournamentStage {
  id           String            @id @default(uuid())
  tournamentId String            @map("tournament_id")
  stageIndex   Int               @default(0) @map("stage_index")
  stageType    String            @default("KNOCKOUT") @map("stage_type")
  status       String            @default("PENDING") // "PENDING" | "IN_PROGRESS" | "COMPLETED"
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  // Relations
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rounds       TournamentRound[]

  @@unique([tournamentId, stageIndex])
  @@map("tournament_stages")
}

// ==================================================
// 12. TournamentRound: Sequential Bracket Level
// ==================================================
model TournamentRound {
  id         String            @id @default(uuid())
  stageId    String            @map("stage_id")
  roundIndex Int               @map("round_index")
  name       String
  status     String            @default("PENDING") // "PENDING" | "IN_PROGRESS" | "COMPLETED"
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  // Relations
  stage      TournamentStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[]

  @@unique([stageId, roundIndex])
  @@map("tournament_rounds")
}

// ==================================================
// 13. TournamentMatch: Individual Bracket Match Node
// ==================================================
model TournamentMatch {
  id                String          @id @default(uuid())
  roundId           String          @map("round_id")
  matchIndex        Int             @map("match_index")
  participantAId    String?         @map("participant_a_id")
  participantBId    String?         @map("participant_b_id")
  winnerId          String?         @map("winner_id")
  scoreA            Int             @default(0) @map("score_a")
  scoreB            Int             @default(0) @map("score_b")
  status            String          @default("PENDING") // "PENDING" | "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  gameRoomId        String?         @map("game_room_id")
  referencedMatchId String?         @map("referenced_match_id")
  nextMatchId       String?         @map("next_match_id")
  nextMatchSlot     String?         @map("next_match_slot") // "A" | "B"
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  round             TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, matchIndex])
  @@index([roundId])
  @@index([nextMatchId])
  @@map("tournament_matches")
}

