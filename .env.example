# ==================================================
# THUNDER DOME FIGHTER - ENVIRONMENT CONFIGURATION
# ==================================================

# Database (PostgreSQL inside Docker)
POSTGRES_USER=thunder_dev
POSTGRES_PASSWORD=thunder_dev_password
POSTGRES_DB=thunder_dome_fighter
DATABASE_URL="postgresql://thunder_dev:thunder_dev_password@localhost:5433/thunder_dome_fighter?schema=public"

# Cache & Matchmaking Presence (Redis inside Docker)
REDIS_URL="redis://localhost:6379"

# Fastify HTTP Server
FASTIFY_PORT=3000
FASTIFY_HOST=0.0.0.0
JWT_SECRET=super-secret-jwt-dev-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# Colyseus Game Server
COLYSEUS_PORT=2567
COLYSEUS_HOST=0.0.0.0

# Client Vite Configuration
VITE_API_URL="http://localhost:3000"
VITE_COLYSEUS_URL="ws://localhost:2567"
